pipeline {
  agent any
  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
  }
  parameters {
    string(name: 'RELEASE_VERSION', defaultValue: '10.11.0', description: 'Release version to sync')
    booleanParam(name: 'DRY_RUN', defaultValue: true, description: 'Run without pushing or creating PR')
  }
  environment {
    PYTHONUNBUFFERED = '1'
  }
  stages {
    stage('Checkout Automation Repository') {
      steps { checkout scm }
    }
    stage('Setup Python') {
      steps {
        sh 'python3.12 -m venv .venv'
        sh '. .venv/bin/activate && pip install -r automation/python/requirements.txt'
      }
    }
    stage('Validate Release') {
      steps { sh 'automation/scripts/validate_release.sh ${RELEASE_VERSION}' }
    }
    stage('Run Synchronization') {
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
          sh '''
            . .venv/bin/activate
            if [ "${DRY_RUN}" = "true" ]; then
              automation/scripts/run_sync.sh "${RELEASE_VERSION}" --dry-run
            else
              automation/scripts/run_sync.sh "${RELEASE_VERSION}"
            fi
          '''
        }
      }
    }
  }
  post {
    failure {
      echo 'Synchronization failed.'
    }
    success {
      echo 'Synchronization completed successfully.'
    }
    always {
      cleanWs(cleanWhenNotBuilt: false)
    }
  }
}
